# Barchart credentials
BARCHART_EMAIL=
BARCHART_PASSWORD=

# Google OAuth2 — covers both Drive and Sheets (run scripts/auth_drive.py once)
# Download client JSON from: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_TOKEN_JSON=
# Drive folder ID — from the folder URL: drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=

# Sheets ID — only needed for LLM analysis results and dashboard
GOOGLE_SPREADSHEET_ID=

# Trade journal (separate sheet from the options data sheet)
TRADE_JOURNAL_SPREADSHEET_ID=


# Scraper settings
COOKIES_PATH=
SCRAPE_HEADLESS=true

# --- IBKR: Flex is the only transport ------------------------------------
# scripts.journal talks to IBKR through the Flex Web Service, never a locally
# run gateway (that Client Portal Gateway transport was deleted 2026-08-15).
# Account id — only a label on the pull, not used to authenticate anything.
IBKR_ACCOUNT_ID=

# REQUIRED for the default (fetching) run: `python3 -m scripts.journal` pulls
# the statement over the network with these. Create a Flex Query (Reporting >
# Flex Queries, Trades section, CSV) and a token (Reporting > Settings > Flex
# Web Service) in IBKR Account Management.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_TRADES_ID=
# Optional but strongly recommended: a Flex Query saved WITH the Open Positions
# section, so the open book is read directly from the broker rather than
# reconstructed by netting fills. If set, it must point at a query that actually
# carries that section — one that doesn't is refused rather than silently read
# as an (incorrect) flat book.
#
# TWO WAYS TO SET IT. Either a SECOND query id here (two saved queries, two
# handshakes), or the SAME id as IBKR_FLEX_QUERY_TRADES_ID above when that one
# query was saved with BOTH the Trades and Open Positions sections — then the
# pull fetches once and splits the sections apart, halving the requests against
# IBKR's per-token rate limit. Works in CSV; no XML needed.
IBKR_FLEX_OPEN_POSITIONS_QUERY_ID=

# No token? Run `python3 -m scripts.journal --offline` to read only what's on
# disk (`portfolio/input/trades_*.csv`, or `--from-flex`/`--from-flex-positions`
# for specific files) — no network touched, IBKR_FLEX_TOKEN left blank is fine.

# A Flex trades query reports no account equity, and every exposure cap is a
# fraction of it. Set this (or pass --net-liq) to make the caps evaluable;
# unset, the risk section reports "not evaluable" rather than guessing.
JOURNAL_NET_LIQUIDATION=
