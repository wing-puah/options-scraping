<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Operator-installed. Runs backfill_supervisor.sh every 30 min; the supervisor exits at once
     if a pass is already running, cooling down, DONE or HALTed.
     Install:   cp scripts/collector/com.wing.options-backfill.plist ~/Library/LaunchAgents/ &&
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wing.options-backfill.plist
     Remove:    launchctl bootout gui/$(id -u)/com.wing.options-backfill &&
                rm ~/Library/LaunchAgents/com.wing.options-backfill.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wing.options-backfill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wing/claude_playground/options-trading/scripts/collector/backfill_supervisor.sh</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/wing/claude_playground/options-trading/logs/backfill/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/wing/claude_playground/options-trading/logs/backfill/launchd.err</string>
</dict>
</plist>
