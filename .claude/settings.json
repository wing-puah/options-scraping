{
  "permissions": {
    "allow": ["mcp__codegraph__*"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/delegation-nudge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/scripts/check_prose.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking prose readability"
          }
        ]
      }
    ]
  }
}
